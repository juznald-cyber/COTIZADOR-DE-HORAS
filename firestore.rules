rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Almacenamiento seguro por usuario:
    // Colección 'user_data' donde cada documento es el identificador seguro del usuario
    match /user_data/{userId} {
      allow read, write: if true;

      match /{document=**} {
        allow read, write: if true;
      }
    }

    // Regla de cuentas de usuario para validar contraseñas de forma remota entre dispositivos
    match /user_accounts/{userAccount} {
      allow read, write: if true;
    }
  }
}
